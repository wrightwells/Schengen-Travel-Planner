# Generate a random URL-safe value (e.g. openssl rand -hex 32). Never commit .env.
DB_PASSWORD=
# Short-lived Tailscale enrolment key; can be removed after successful enrolment.
TS_AUTHKEY=
# Exact tailnet hostname, comma-separated if more than one host is required.
ALLOWED_HOSTS=schengen-planner.YOUR-TAILNET.ts.net
